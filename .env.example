# ── Database (PostgreSQL 17) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commerce_os?schema=public"

# ── Cache & Queues (Redis 7) ──
REDIS_URL="redis://localhost:6379"

# ── Security & Authentication ──
AUTH_SECRET="f4d5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_EXPIRATION="7d"

# ── API Gateway & Host ──
PORT=4000
API_PUBLIC_URL="http://localhost:4000"
STOREFRONT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# ── Payment Gateways (Iranian Banking) ──
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_SANDBOX=true
ZIBAL_MERCHANT_ID="zibal"
ZIBAL_SANDBOX=true

# Default Merchant Bank Card for Card-to-Card Transfer
MERCHANT_CARD_NUMBER="6219861012345678"
MERCHANT_CARD_HOLDER="فروشگاه مرکزی کامرس او اس"
MERCHANT_BANK_NAME="بانک سامان"
MERCHANT_SHEBA="IR000000000000000000000000"

# ── Node Environment ──
NODE_ENV="development"
