{
  "name": "@commerce-os/storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node -e \"const fs=require('fs'); if(fs.existsSync('.next/standalone')){ fs.cpSync('.next/static', '.next/standalone/apps/storefront/.next/static', {recursive:true}); fs.cpSync('public', '.next/standalone/apps/storefront/public', {recursive:true}); }\"",
    "start": "next start -p 3000",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@commerce-os/domain": "workspace:*",
    "@commerce-os/localization": "workspace:*",
    "@commerce-os/ui": "workspace:*",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.66.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
