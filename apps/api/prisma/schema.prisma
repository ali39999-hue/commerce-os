generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  OPERATOR
  ACCOUNTANT
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  ARCHIVED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  COMPLETED
}

enum PaymentIntentStatus {
  CREATED
  PENDING_PROVIDER
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  EXPIRED
  UNKNOWN
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  ZARINPAL
  ZIBAL
  CARD_TO_CARD
  WALLET
}

enum CardToCardStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ShipmentStatus {
  PENDING
  PACKED
  HANDED_TO_CARRIER
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  FAILED_ATTEMPT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum IdempotencyStatus {
  STARTED
  COMPLETED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum QuoteRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  CLOSED
}

enum ProductKind {
  PHYSICAL
  DIGITAL
}

// ── Multi-Tenant Hierarchy ──

model Tenant {
  id             String         @id @default(uuid()) @db.Uuid
  slug           String         @unique @db.VarChar(80)
  name           String         @db.VarChar(200)
  status         TenantStatus   @default(ACTIVE)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  organizations  Organization[]
  users          User[]

  @@map("tenants")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  slug      String   @db.VarChar(80)
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stores    Store[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("organizations")
}

model Store {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.Uuid
  organizationId  String      @db.Uuid
  slug            String      @unique @db.VarChar(100)
  name            String      @db.VarChar(200)
  status          StoreStatus @default(ACTIVE)
  defaultCurrency String      @default("IRR") @db.Char(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)
  organization    Organization @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict)

  products        Product[]
  categories      Category[]
  orders          Order[]
  carts           Cart[]
  checkoutSessions CheckoutSession[]
  coupons         Coupon[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("stores")
}

// ── Identity & RBAC ──

model User {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String?       @db.Uuid
  phone        String        @db.VarChar(20)
  email        String?       @db.VarChar(120)
  fullName     String?       @db.VarChar(150)
  passwordHash String?       @db.VarChar(255)
  nationalId   String?       @db.VarChar(20)
  role         UserRole      @default(CUSTOMER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions     UserSession[]
  orders       Order[]
  wallets      Wallet[]

  @@unique([phone])
  @@index([tenantId, role])
  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  sessionToken String   @unique @db.VarChar(255)
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.Text
  expiresAt    DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model OtpChallenge {
  id         String   @id @default(uuid()) @db.Uuid
  phone      String   @db.VarChar(20)
  codeHash   String   @db.VarChar(128)
  salt       String   @db.VarChar(64)
  attempts   Int      @default(0)
  isUsed     Boolean  @default(false)
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([phone, expiresAt, isUsed])
  @@map("otp_challenges")
}

// ── Catalog ──

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  storeId     String    @db.Uuid
  slug        String    @db.VarChar(100)
  titleFa     String    @db.VarChar(200)
  description String?   @db.Text
  parentId    String?   @db.Uuid
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryHierarchy")
  store       Store     @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  products    Product[]

  @@unique([storeId, slug])
  @@index([tenantId, storeId])
  @@map("categories")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  storeId     String           @db.Uuid
  categoryId  String?          @db.Uuid
  vendorId    String?          @db.Uuid
  kind        ProductKind      @default(PHYSICAL)
  slug        String           @db.VarChar(180)
  titleFa     String           @db.VarChar(300)
  description String?          @db.Text
  status      ProductStatus    @default(DRAFT)
  publishedAt DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  store       Store            @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor      Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]

  @@unique([storeId, slug])
  @@unique([tenantId, storeId, id])
  @@index([tenantId, storeId, status, publishedAt])
  @@index([vendorId])
  @@map("products")
}

// ── Marketplace Vendor Foundation (W18 — ADR-011) ──

model Vendor {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  slug          String    @db.VarChar(120)
  titleFa       String    @db.VarChar(200)
  description   String?   @db.Text
  logoColor     String    @default("#0B6E66") @db.VarChar(9)
  commissionBps Int       @default(1000)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  products      Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("vendors")
}

model ProductVariant {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  storeId         String           @db.Uuid
  productId       String           @db.Uuid
  sku             String           @unique @db.VarChar(100)
  titleFa         String           @db.VarChar(200)
  priceAmount     Decimal          @db.Decimal(20, 0)
  currency        String           @default("IRR") @db.Char(3)
  status          VariantStatus    @default(ACTIVE)
  digitalFileUrl  String?          @db.Text
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  product         Product          @relation(fields: [tenantId, storeId, productId], references: [tenantId, storeId, id], onDelete: Restrict)
  inventoryLevels InventoryLevel[]
  reservationLines InventoryReservationLine[]
  orderLines      OrderLine[]
  cartLines       CartLine[]

  @@unique([tenantId, storeId, id])
  @@index([tenantId, storeId, status])
  @@map("product_variants")
}

// ── Inventory & Reservation ──

model InventoryLevel {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  storeId       String         @db.Uuid
  variantId     String         @db.Uuid
  warehouseCode String         @default("MAIN") @db.VarChar(80)
  onHandQty     Int            @default(0)
  reservedQty   Int            @default(0)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  variant       ProductVariant @relation(fields: [tenantId, storeId, variantId], references: [tenantId, storeId, id], onDelete: Restrict)

  @@unique([tenantId, storeId, variantId, warehouseCode])
  @@index([tenantId, storeId, variantId])
  @@map("inventory_levels")
}

model InventoryReservation {
  id        String                     @id @default(uuid()) @db.Uuid
  tenantId  String                     @db.Uuid
  storeId   String                     @db.Uuid
  status    ReservationStatus          @default(ACTIVE)
  expiresAt DateTime                   @db.Timestamptz(6)
  createdAt DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime                   @updatedAt @db.Timestamptz(6)
  lines     InventoryReservationLine[]

  @@index([tenantId, storeId, status, expiresAt])
  @@map("inventory_reservations")
}

model InventoryReservationLine {
  id            String               @id @default(uuid()) @db.Uuid
  reservationId String               @db.Uuid
  variantId     String               @db.Uuid
  warehouseCode String               @default("MAIN") @db.VarChar(80)
  reservedQty   Int
  reservation   InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  variant       ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@map("inventory_reservation_lines")
}

// ── Cart & Checkout ──

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  storeId   String     @db.Uuid
  userId    String?    @db.Uuid
  sessionId String?    @db.VarChar(128)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  store     Store      @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  lines     CartLine[]

  @@index([tenantId, storeId, userId, sessionId])
  @@map("carts")
}

model CartLine {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  qty       Int            @default(1)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@map("cart_lines")
}

model CheckoutSession {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  storeId          String   @db.Uuid
  cartId           String?  @db.Uuid
  reservationId    String?  @db.Uuid
  quoteFingerprint String   @db.VarChar(64)
  quoteSnapshot    Json     @db.JsonB
  addressSnapshot  Json?    @db.JsonB
  expiresAt        DateTime @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  store            Store    @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, storeId, expiresAt])
  @@map("checkout_sessions")
}

// ── Orders & Lifecycle ──

model Order {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  storeId        String               @db.Uuid
  orderNumber    String               @unique @db.VarChar(50)
  userId         String?              @db.Uuid
  customerPhone  String               @db.VarChar(20)
  customerName   String               @db.VarChar(150)
  status         OrderStatus          @default(PENDING_PAYMENT)
  subtotalAmount Decimal              @db.Decimal(20, 0)
  discountAmount Decimal              @default(0) @db.Decimal(20, 0)
  vatAmount      Decimal              @default(0) @db.Decimal(20, 0)
  shippingAmount Decimal              @default(0) @db.Decimal(20, 0)
  totalAmount    Decimal              @db.Decimal(20, 0)
  currency       String               @default("IRR") @db.Char(3)
  addressJson    Json                 @db.JsonB
  priceSnapshot  Json                 @db.JsonB
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)

  store          Store                @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines          OrderLine[]
  history        OrderStatusHistory[]
  paymentIntents PaymentIntent[]
  shipments      Shipment[]

  @@unique([tenantId, storeId, id])
  @@index([tenantId, storeId, status, createdAt])
  @@map("orders")
}

model OrderLine {
  id         String         @id @default(uuid()) @db.Uuid
  orderId    String         @db.Uuid
  variantId  String         @db.Uuid
  titleFa    String         @db.VarChar(250)
  sku        String         @db.VarChar(100)
  unitPrice  Decimal        @db.Decimal(20, 0)
  qty        Int
  subtotal   Decimal        @db.Decimal(20, 0)
  discount   Decimal        @default(0) @db.Decimal(20, 0)
  total      Decimal        @db.Decimal(20, 0)
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_lines")
}

model OrderStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @db.Uuid
  fromStatus OrderStatus
  toStatus   OrderStatus
  actor      String      @db.VarChar(100)
  reason     String?     @db.VarChar(255)
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ── Payments & Transactions ──

model PaymentIntent {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  storeId            String              @db.Uuid
  orderId            String              @db.Uuid
  method             PaymentMethod
  status             PaymentIntentStatus @default(CREATED)
  amount             Decimal             @db.Decimal(20, 0)
  currency           String              @default("IRR") @db.Char(3)
  gatewayTrackingId  String?             @db.VarChar(100)
  refId              String?             @db.VarChar(100)
  cardPan            String?             @db.VarChar(30)
  errorMessage       String?             @db.Text
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cardToCardReceipts CardToCardReceipt[]

  @@unique([tenantId, storeId, id])
  @@index([orderId, status])
  @@map("payment_intents")
}

model CardToCardReceipt {
  id              String           @id @default(uuid()) @db.Uuid
  paymentIntentId String           @db.Uuid
  referenceNumber String           @db.VarChar(100)
  payerCardNumber String?          @db.VarChar(30)
  receiptImageUrl String?          @db.Text
  status          CardToCardStatus @default(PENDING_REVIEW)
  reviewedBy      String?          @db.VarChar(100)
  reviewedAt      DateTime?        @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  paymentIntent   PaymentIntent    @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([paymentIntentId, status])
  @@map("card_to_card_receipts")
}

model WebhookInbox {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @db.VarChar(50)
  eventId     String    @db.VarChar(100)
  payloadJson Json      @db.JsonB
  status      String    @default("PENDING") @db.VarChar(30)
  processedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@map("webhook_inbox")
}

// ── Wallet ──

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  userId       String              @db.Uuid
  balance      Decimal             @default(0) @db.Decimal(20, 0)
  currency     String              @default("IRR") @db.Char(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@unique([tenantId, userId, currency])
  @@map("wallets")
}

model WalletTransaction {
  id           String          @id @default(uuid()) @db.Uuid
  walletId     String          @db.Uuid
  direction    LedgerDirection
  amount       Decimal         @db.Decimal(20, 0)
  refType      String          @db.VarChar(50)
  refId        String          @db.VarChar(100)
  description  String          @db.VarChar(255)
  balanceAfter Decimal         @db.Decimal(20, 0)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  wallet       Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

// ── General Ledger & Double-Entry Accounting ──

model LedgerAccount {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  code        String          @db.VarChar(20)
  nameFa      String          @db.VarChar(150)
  category    AccountCategory
  currency    String          @default("IRR") @db.Char(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  entries     LedgerEntry[]

  @@unique([tenantId, code, currency])
  @@map("ledger_accounts")
}

model LedgerJournal {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  storeId     String?       @db.Uuid
  ref         String        @db.VarChar(120)
  sourceType  String        @db.VarChar(50)
  sourceId    String        @db.VarChar(100)
  description String        @db.VarChar(300)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  entries     LedgerEntry[]

  @@unique([tenantId, ref])
  @@index([tenantId, sourceType, sourceId])
  @@map("ledger_journals")
}

model LedgerEntry {
  id          String          @id @default(uuid()) @db.Uuid
  journalId   String          @db.Uuid
  accountId   String          @db.Uuid
  direction   LedgerDirection
  amount      Decimal         @db.Decimal(20, 0)
  currency    String          @default("IRR") @db.Char(3)
  description String?         @db.VarChar(255)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  journal     LedgerJournal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account     LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalId])
  @@index([accountId, createdAt])
  @@map("ledger_entries")
}

// ── Coupons & Promotions ──

model Coupon {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  storeId          String             @db.Uuid
  code             String             @db.VarChar(50)
  discountBps      Int?
  fixedDiscount    Decimal?           @db.Decimal(20, 0)
  minSubtotal      Decimal?           @db.Decimal(20, 0)
  maxDiscount      Decimal?           @db.Decimal(20, 0)
  usageLimit       Int?
  usedCount        Int                @default(0)
  expiresAt        DateTime?          @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  store            Store              @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  redemptions      CouponRedemption[]

  @@unique([tenantId, storeId, code])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @db.Uuid
  orderId    String   @db.Uuid
  userId     String?  @db.Uuid
  redeemedAt DateTime @default(now()) @db.Timestamptz(6)
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@map("coupon_redemptions")
}

// ── Shipping & Logistics ──

model ShippingMethod {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  code        String     @db.VarChar(50)
  carrier     String     @db.VarChar(50)
  titleFa     String     @db.VarChar(150)
  baseFee     Decimal    @db.Decimal(20, 0)
  isActive    Boolean    @default(true)
  shipments   Shipment[]

  @@unique([tenantId, code])
  @@map("shipping_methods")
}

model Shipment {
  id             String                  @id @default(uuid()) @db.Uuid
  orderId        String                  @db.Uuid
  methodId       String?                 @db.Uuid
  carrier        String                  @db.VarChar(50)
  trackingNumber String?                 @db.VarChar(100)
  status         ShipmentStatus          @default(PENDING)
  dispatchedAt   DateTime?               @db.Timestamptz(6)
  deliveredAt    DateTime?               @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(6)

  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  method         ShippingMethod?         @relation(fields: [methodId], references: [id], onDelete: SetNull)
  events         ShipmentTrackingEvent[]

  @@index([orderId, status])
  @@map("shipments")
}

model ShipmentTrackingEvent {
  id          String   @id @default(uuid()) @db.Uuid
  shipmentId  String   @db.Uuid
  titleFa     String   @db.VarChar(150)
  description String?  @db.Text
  location    String?  @db.VarChar(100)
  occurredAt  DateTime @default(now()) @db.Timestamptz(6)
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_tracking_events")
}

// ── Outbox, Idempotency & System Leases ──

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String?      @db.Uuid
  eventType   String       @db.VarChar(100)
  payloadJson Json         @db.JsonB
  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0)
  availableAt DateTime     @default(now()) @db.Timestamptz(6)
  lockedAt    DateTime?    @db.Timestamptz(6)
  workerId    String?      @db.VarChar(100)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  scope        String            @db.VarChar(60)
  key          String            @db.VarChar(128)
  requestHash  String            @db.VarChar(64)
  status       IdempotencyStatus @default(STARTED)
  responseJson Json?             @db.JsonB
  expiresAt    DateTime          @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([tenantId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model WorkerLease {
  resourceName String   @id @db.VarChar(100)
  holderId     String   @db.VarChar(100)
  acquiredAt   DateTime @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime @db.Timestamptz(6)
  heartbeatAt  DateTime @default(now()) @db.Timestamptz(6)
  version      Int      @default(1)

  @@map("worker_leases")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid
  actorId    String   @db.VarChar(100)
  action     String   @db.VarChar(100)
  targetType String   @db.VarChar(80)
  targetId   String   @db.VarChar(100)
  diffJson   Json?    @db.JsonB
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}

// ── Reviews & Moderation ──

model Review {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  productId          String       @db.Uuid
  userId             String?      @db.Uuid
  authorName         String       @db.VarChar(100)
  rating             Int
  title              String       @db.VarChar(150)
  body               String       @db.Text
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  moderatedBy        String?      @db.VarChar(100)
  moderatedAt        DateTime?    @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)

  @@index([productId, status, createdAt])
  @@index([tenantId, status])
  @@map("reviews")
}

// ── Notifications (Outbox consumer target) ──

model NotificationDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String?   @db.Uuid
  channel       String    @db.VarChar(20)
  recipient     String    @db.VarChar(160)
  templateKey   String    @db.VarChar(60)
  title         String    @db.VarChar(200)
  body          String    @db.Text
  status        String    @default("QUEUED") @db.VarChar(20)
  outboxEventId String?   @db.VarChar(64)
  sentAt        DateTime? @db.Timestamptz(6)
  error         String?   @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([tenantId, channel])
  @@map("notification_deliveries")
}

// ── Outgoing Webhooks (HMAC-signed) ──

model WebhookDelivery {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  eventType   String    @db.VarChar(60)
  targetUrl   String    @db.Text
  payloadJson Json      @db.JsonB
  signature   String    @db.VarChar(128)
  status      String    @default("PENDING") @db.VarChar(20)
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  deliveredAt DateTime? @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([tenantId, eventType])
  @@map("webhook_deliveries")
}

// ── Analytics Event Store (server-side, PII-free) ──

model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  storeId   String?  @db.Uuid
  name      String   @db.VarChar(60)
  sessionId String?  @db.VarChar(64)
  userId    String?  @db.Uuid
  propsJson Json?    @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([name, createdAt])
  @@index([storeId, createdAt])
  @@map("analytics_events")
}

// ── Loyalty (باشگاه مشتریان — امتیاز به‌عنوان بدهی شرکت) ──

model LoyaltyAccount {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @db.Uuid
  userId    String               @db.Uuid
  points    Int                  @default(0)
  tier      String               @default("BRONZE") @db.VarChar(20)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @db.Timestamptz(6)
  transactions LoyaltyTransaction[]

  @@unique([tenantId, userId])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id           String         @id @default(uuid()) @db.Uuid
  accountId    String         @db.Uuid
  direction    String         @db.VarChar(10)
  points       Int
  refType      String         @db.VarChar(50)
  refId        String         @db.VarChar(100)
  description  String         @db.VarChar(255)
  balanceAfter Int
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  account      LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("loyalty_transactions")
}

// ── Subscriptions (اشتراک‌های دوره‌ای) ──

model SubscriptionPlan {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  storeId      String         @db.Uuid
  slug         String         @db.VarChar(120)
  titleFa      String         @db.VarChar(200)
  description  String?        @db.Text
  variantId    String?        @db.Uuid
  intervalDays Int            @default(30)
  priceRials   Decimal        @db.Decimal(20, 0)
  currency     String         @default("IRR") @db.Char(3)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)
  subscriptions Subscription[]

  @@unique([tenantId, slug])
  @@index([tenantId, storeId, isActive])
  @@map("subscription_plans")
}

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  planId       String             @db.Uuid
  userId       String             @db.Uuid
  phone        String             @db.VarChar(20)
  quantity     Int                @default(1)
  status       SubscriptionStatus @default(ACTIVE)
  nextRunAt    DateTime           @db.Timestamptz(6)
  lastRunAt    DateTime?          @db.Timestamptz(6)
  cyclesRun    Int                @default(0)
  cancelReason String?            @db.VarChar(255)
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)
  plan         SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, nextRunAt])
  @@index([userId, status])
  @@map("subscriptions")
}

// ── Digital Goods Grants (W18 — ADR-012) ──

model DigitalGrant {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  orderId       String   @db.Uuid
  orderLineId   String   @db.Uuid
  variantId     String   @db.Uuid
  userId        String?  @db.Uuid
  phone         String   @db.VarChar(20)
  token         String   @unique @db.VarChar(64)
  productTitle  String   @db.VarChar(300)
  downloadCount Int      @default(0)
  maxDownloads  Int      @default(5)
  revokedAt     DateTime? @db.Timestamptz(6)
  expiresAt     DateTime @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([orderLineId])
  @@index([phone, createdAt])
  @@index([tenantId, createdAt])
  @@map("digital_grants")
}

// ── B2B Quote Requests (استعلام قیمت عمده) ──

model QuoteRequest {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  companyName  String             @db.VarChar(200)
  contactName  String             @db.VarChar(150)
  phone        String             @db.VarChar(20)
  email        String?            @db.VarChar(120)
  itemsSummary String             @db.Text
  desiredQty   Int                @default(1)
  status       QuoteRequestStatus @default(NEW)
  adminNote    String?            @db.VarChar(500)
  quotedAt     DateTime?          @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)

  @@index([tenantId, status, createdAt])
  @@map("quote_requests")
}
