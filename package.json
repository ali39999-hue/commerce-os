{
  "name": "commerce-os",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Multi-Tenant Modular Monolith Commerce Operating System",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @commerce-os/api run dev",
    "dev:storefront": "pnpm --filter @commerce-os/storefront run dev",
    "dev:admin": "pnpm --filter @commerce-os/admin run dev",
    "dev:worker": "pnpm --filter @commerce-os/worker run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@types/node": "^22.13.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
